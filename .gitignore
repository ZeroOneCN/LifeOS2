# 工具/数据目录（含敏感业务数据，不入库）
.trae/

# Trae HTML 分享包缓存与本地截图临时目录（过程产物，不入库）
.trae-html-share-packages/
.screenshots/

# 数据库备份文件（保留本地归档，不入库）
backend/backups/

# 用户上传文件（头像等，不入库）
backend/uploads/

# App 发布产物（APK 与版本清单由 scripts/build_release_apk.ps1 生成，不入库）
backend/downloads/

# 用户业务数据/导入备份（不入库）
*.xlsx

# 本地环境变量（含敏感加密密钥）
.env
backend/.env

# Python / Node
backend/.venv/
frontend/node_modules/
__pycache__/
*.pyc

# 本地临时 SQLite（测试/脚本残留，不入库）
backend/_tmp_auth_test.db
*.db
# 数据库迁移备份归档（保留本地，不入库）
backend/migrations/backup/
