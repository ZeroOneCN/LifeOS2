# 复制为 .env 后按需修改
PROJECT_NAME=LifeOS API

# 数据库连接串（必填，禁止在代码中硬编码账号密码）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/lifeos?charset=utf8mb4

# JWT 签名密钥（生产环境务必修改为随机值）
JWT_SECRET_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL，默认 INFO
LOG_LEVEL=INFO

# 运行环境：development（本地开发）/ production（生产）。
# 非开发环境下 JWT_SECRET_KEY 为空或仍为默认值时，应用会拒绝启动
ENVIRONMENT=development

# mysqldump 可执行文件路径（SQL 导出优先使用，留空则自动降级为纯 Python 方式）
MYSQLDUMP_PATH=

# 每月 1 日自动生成上月报告的时间（HH:MM）
MONTHLY_REPORT_TIME=00:10

# 体重秤采集（进程内蓝牙扫描）：无蓝牙环境请保持 false
ENABLE_SCALE_COLLECTOR=false
# 数据归属用户 id（0 表示自动取第一个用户）
SCALE_USER_ID=0
# 设备名前缀（蚂蚁阿福秤为 AFU）
SCALE_NAME_PREFIX=AFU
# 体成分估算兜底资料（找不到用户资料时生效）
SCALE_HEIGHT_CM=173
SCALE_AGE=25
SCALE_SEX=male

# 头像上传目录（相对 backend 根目录或绝对路径），该目录已被 .gitignore 排除
AVATAR_UPLOAD_DIR=uploads/avatars
# 头像图片大小上限（字节），默认 2 MB
AVATAR_MAX_BYTES=2097152