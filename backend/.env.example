# 复制为 .env 后按需修改
PROJECT_NAME=LifeOS API

# 数据库连接串（必填，禁止在代码中硬编码账号密码）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/lifeos?charset=utf8mb4

# JWT 签名密钥（生产环境务必修改为随机值）
JWT_SECRET_KEY=

# mysqldump 可执行文件路径（SQL 导出优先使用，留空则自动降级为纯 Python 方式）
MYSQLDUMP_PATH=

# 体重秤采集（进程内蓝牙扫描）：无蓝牙环境请保持 false
ENABLE_SCALE_COLLECTOR=false
# 数据归属用户 id（0 表示自动取第一个用户）
SCALE_USER_ID=0
# 设备名前缀（蚂蚁阿福秤为 AFU）
SCALE_NAME_PREFIX=AFU
# 体成分估算兜底资料（找不到用户资料时生效）
SCALE_HEIGHT_CM=173
SCALE_AGE=25
SCALE_SEX=male