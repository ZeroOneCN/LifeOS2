# 复制为 .env 后按需修改
PROJECT_NAME=LifeOS API

# 数据库连接串（必填，禁止在代码中硬编码账号密码）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/lifeos?charset=utf8mb4

# JWT 签名密钥（生产环境务必修改为随机值）
JWT_SECRET_KEY=

# mysqldump 可执行文件路径（SQL 格式导出需要，留空则从 PATH 查找）
# Windows 示例: MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# macOS 示例: MYSQLDUMP_PATH=/usr/local/mysql/bin/mysqldump
MYSQLDUMP_PATH=